          },
          "Exec ID": {
            "type": "Integer",
             "min": 1,
            "max": 190,
            "description": "Number of Executor to change",
            "default": 1
          },
          "Color": {
            "type": "Color",
            "description": "Color to set Executor to."
          }
        }
      },
      "Encoder by Wheel": {
        "menu": "Encoders",
        "callback": "commandSendEncoderByWheel",
        "parameters": {
          "Encoder": {
            "type": "Integer",
             "min": 1,
            "max": 5,
            "description": "Executor ID",
            "default": 1},
          "Step Amount": {
            "type": "Float",
             "min": -10.0,
            "max": 10.0,
            "description": "Amount to add / substract per tick."
          }
        }
      },
      "Encoder by Attribute": {
        "menu": "Encoders",
        "callback": "commandSendEncoderByAttribute",
        "parameters": {
          "Attribute": {
            "type": "String",
            "description": "Attribute to control.",
            "default": "DIM"},
          "Step Amount": {
            "type": "Float",
             "min": -10.0,
            "max": 10.0,
            "description": "Amount to add / substract per tick."
          }
        }
      },
      "Set Programmer RGB Value": {
        "menu": "Encoders",
        "callback": "commandSetPGMRGBColor",
        "parameters": {
          "RGB Color": {
          "type": "Color",
          "description": ""
        }
      }
    }
  }
}
